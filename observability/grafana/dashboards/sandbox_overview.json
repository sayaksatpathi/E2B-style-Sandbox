{
  "title": "Sandbox Platform Overview",
  "uid": "sandbox-overview",
  "version": 1,
  "schemaVersion": 38,
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "title": "Active Sandboxes",
      "type": "stat",
      "datasource": "Prometheus",
      "targets": [{ "expr": "active_sandboxes", "legendFormat": "Active" }],
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 }
    },
    {
      "id": 2,
      "title": "Sandbox Creation Rate",
      "type": "timeseries",
      "datasource": "Prometheus",
      "targets": [{ "expr": "rate(sandboxes_created_total[5m])", "legendFormat": "Created/s" }],
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 }
    },
    {
      "id": 3,
      "title": "Execution Rate",
      "type": "timeseries",
      "datasource": "Prometheus",
      "targets": [
        { "expr": "rate(sandbox_execution_total[5m])", "legendFormat": "Exec/s" },
        { "expr": "rate(sandbox_execution_failures_total[5m])", "legendFormat": "Failures/s" }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 }
    },
    {
      "id": 4,
      "title": "p95 Execution Latency",
      "type": "timeseries",
      "datasource": "Prometheus",
      "targets": [{
        "expr": "histogram_quantile(0.95, rate(sandbox_execution_duration_seconds_bucket[5m]))",
        "legendFormat": "p95 latency (s)"
      }],
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 }
    },
    {
      "id": 5,
      "title": "Expired Sandboxes",
      "type": "stat",
      "datasource": "Prometheus",
      "targets": [{ "expr": "sandbox_expired_total", "legendFormat": "Expired" }],
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 0 }
    },
    {
      "id": 6,
      "title": "Creation Failures",
      "type": "stat",
      "datasource": "Prometheus",
      "targets": [{ "expr": "sandbox_creation_failures_total", "legendFormat": "Failures" }],
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "steps": [{ "color": "green", "value": 0 }, { "color": "red", "value": 1 }] } } },
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 0 }
    }
  ],
  "time": { "from": "now-1h", "to": "now" }
}
